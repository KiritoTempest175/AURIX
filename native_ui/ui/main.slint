    // ── Global ESC key handler (modal compat) ────────────────────────────────
    forward-focus: ks;
    ks := FocusScope {
        key-pressed(ev) => {
            if (ev.text == Key.Escape) {
                if (root.alert-modal-open)  { root.alert-modal-open  = false; root.alert-modal-closed();  return accept; }
                if (root.review-modal-open) { root.review-modal-open = false; root.review-modal-closed(); return accept; }
            }
            reject
        }
    }

    // ── Dark Slate Canvas Background & Subtle Grid ──
