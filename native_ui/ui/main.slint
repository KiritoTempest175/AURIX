// ═══════════════════════════════════════════════════════════════════════════
//  A.U.R.I.X  —  Clean Modular AI Dashboard
//  Modular Architecture:
//    - Top Navigation & System Status Header
//    - Top Hardware Metric Cards Grid (CPU, Memory, Storage, Thermals)
//    - Voice Control & AI Core Module
//    - AI Chat & Command Log Console Module
// ═══════════════════════════════════════════════════════════════════════════
import { LineEdit, ScrollView } from "std-widgets.slint";
import { ReviewCard, ActionParam } from "components/review_card.slint";
import { AlertModal } from "components/alert_modal.slint";

export { ReviewCard, ActionParam, AlertModal }

export struct ChatMessage {
    sender: string,
    text:   string,
    time:   string,
}

// ─────────────────────────────────────────────────────────────────────────────
//  COMPONENT: ModularCard  — clean rounded card container
// ─────────────────────────────────────────────────────────────────────────────
component ModularCard inherits Rectangle {
    in property <string> title: "";
    in property <string> icon: "";
    in property <color>  card-bg: #0f172ae8;
    in property <color>  card-border: #1e293bcc;

    border-radius: 8px;
    border-width: 1px;
    border-color: root.card-border;
    background: root.card-bg;
    clip: false;
}

// ─────────────────────────────────────────────────────────────────────────────
//  COMPONENT: CleanMeter  — smooth animated progress bar
// ─────────────────────────────────────────────────────────────────────────────
component CleanMeter inherits Rectangle {
    in property <float> value: 0.0;
    in property <color> bar-color: #00d2ff;
    height: 6px;
    border-radius: 3px;
    background: #080f1d;
    clip: true;

    Rectangle {
        x: 0; y: 0;
        height: parent.height;
        border-radius: parent.border-radius;
        width: parent.width * Math.clamp(root.value, 0.0, 1.0);
        background: @linear-gradient(90deg, #0284c7 0%, root.bar-color 100%);
        animate width { duration: 400ms; easing: ease-out; }
    }
}

// ─────────────────────────────────────────────────────────────────────────────
//  COMPONENT: MetricTile  — top row hardware telemetry card
// ─────────────────────────────────────────────────────────────────────────────
component MetricTile inherits ModularCard {
    in property <string> label: "";
    in property <string> main-value: "";
    in property <string> sub-value: "";
    in property <float>  amount: 0.0;
    in property <color>  accent-color: #00d2ff;
    in property <string> tile-icon: "";

    height: 105px;
    card-bg: #0f172ae8;

    VerticalLayout {
        padding: 12px;
        spacing: 6px;

        HorizontalLayout {
            height: 16px;
            Text {
                text: root.tile-icon + " " + root.label;
                color: #64748b;
                font-size: 8.5px;
                font-weight: 700;
                letter-spacing: 0.8px;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: root.main-value;
                color: root.accent-color;
                font-size: 13px;
                font-weight: 800;
                vertical-alignment: center;
            }
        }

        CleanMeter {
            value: root.amount;
            bar-color: root.accent-color;
        }

        HorizontalLayout {
            height: 14px;
            Text {
                text: root.sub-value;
                color: #94a3b8;
                font-size: 8.5px;
                font-weight: 600;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: Math.round(root.amount * 100.0) + "%";
                color: #475569;
                font-size: 8.5px;
                font-weight: 700;
                vertical-alignment: center;
            }
        }
    }
}

// ─────────────────────────────────────────────────────────────────────────────
//  COMPONENT: ControlToggle  — clean media hardware toggle
// ─────────────────────────────────────────────────────────────────────────────
component ControlToggle inherits Rectangle {
    in property <string> icon;
    in property <string> label: "";
    in property <bool>   active: false;
    callback clicked();

    height: 36px;
    min-width: 80px;
    border-radius: 6px;
    border-width: 1px;
    border-color: root.active ? #00d2ff88 : #334155;
    background: root.active ? #00d2ff18 : #1e293b66;
    animate background { duration: 150ms; }
    animate border-color { duration: 150ms; }

    HorizontalLayout {
        alignment: center;
        spacing: 6px;
        padding-left: 10px; padding-right: 10px;

        Text {
            text: root.icon;
            color: root.active ? #00d2ff : #64748b;
            font-size: 12px;
            vertical-alignment: center;
        }
        if root.label != "" : Text {
            text: root.label;
            color: root.active ? #f1f5f9 : #64748b;
            font-size: 9.5px;
            font-weight: 700;
            letter-spacing: 0.5px;
            vertical-alignment: center;
        }
    }
    TouchArea { clicked => { root.clicked(); } }
}

// ─────────────────────────────────────────────────────────────────────────────
//  COMPONENT: VoiceOrb  — animated concentric AI core visualizer
// ─────────────────────────────────────────────────────────────────────────────
component VoiceOrb inherits Rectangle {
    in property <float> anim-phase: 0.0;
    in property <bool>  active: true;

    width: 250px; height: 250px;
    background: #00000000;

    // Outer radial glow aura
    Rectangle {
        x: 0; y: 0; width: 250px; height: 250px;
        border-radius: 125px;
        background: @radial-gradient(circle, #00d2ff20 0%, #0284c70a 45%, #00000000 70%);
        opacity: root.active ? (0.6 + 0.4 * Math.sin(root.anim-phase * 1.0rad)) : 0.2;
        animate opacity { duration: 200ms; }
    }

    // Outer concentric ring
    Rectangle {
        x: 6px; y: 6px; width: 238px; height: 238px;
        border-radius: 119px;
        border-width: 1px; border-color: #00d2ff22;
        background: #00000000;
    }

    // Secondary pulse ring
    Rectangle {
        x: 26px; y: 26px; width: 198px; height: 198px;
        border-radius: 99px;
        border-width: 1.5px;
        border-color: root.active ? #00d2ff55 : #1e293b66;
        background: @radial-gradient(circle, #00d2ff10 0%, #00000000 60%);
        animate border-color { duration: 300ms; }
    }

    // Inner core sphere
    Rectangle {
        x: 65px; y: 65px; width: 120px; height: 120px;
        border-radius: 60px;
        border-width: 2px;
        border-color: root.active ? #00d2ffaa : #0284c744;
        background: @radial-gradient(circle, #0f172a, #030712);
        animate border-color { duration: 300ms; }
    }

    // Cardinal tick indicators
    Rectangle { x: 122px; y: 4px; width: 6px; height: 6px; border-radius: 3px; background: #00d2ff;
        opacity: 0.5 + 0.5 * Math.sin(root.anim-phase * 1.0rad); }
    Rectangle { x: 240px; y: 122px; width: 6px; height: 6px; border-radius: 3px; background: #00d2ff;
        opacity: 0.5 + 0.5 * Math.sin(root.anim-phase * 1.0rad + 1.57rad); }
    Rectangle { x: 122px; y: 240px; width: 6px; height: 6px; border-radius: 3px; background: #00d2ff;
        opacity: 0.5 + 0.5 * Math.sin(root.anim-phase * 1.0rad + 3.14rad); }
    Rectangle { x: 4px; y: 122px; width: 6px; height: 6px; border-radius: 3px; background: #00d2ff;
        opacity: 0.5 + 0.5 * Math.sin(root.anim-phase * 1.0rad + 4.71rad); }

    // 9-Bar Spectrum Waveform in core
    HorizontalLayout {
        x: 86px; y: 106px; width: 78px; height: 38px;
        spacing: 4px; alignment: center;

        Rectangle { width: 3px; border-radius: 1.5px; background: #38bdf8aa;
            height: root.active ? (5px + 7px * Math.abs(Math.sin(root.anim-phase * 1.0rad + 0.0rad))) : 3px;
            y: (38px - self.height) / 2; animate height { duration: 80ms; easing: ease-in-out; } }
        Rectangle { width: 3px; border-radius: 1.5px; background: #38bdf8cc;
            height: root.active ? (7px + 10px * Math.abs(Math.sin(root.anim-phase * 1.0rad + 0.6rad))) : 3px;
            y: (38px - self.height) / 2; animate height { duration: 80ms; easing: ease-in-out; } }
        Rectangle { width: 3px; border-radius: 1.5px; background: #38bdf8ee;
            height: root.active ? (10px + 12px * Math.abs(Math.sin(root.anim-phase * 1.0rad + 1.2rad))) : 4px;
            y: (38px - self.height) / 2; animate height { duration: 80ms; easing: ease-in-out; } }
        Rectangle { width: 3px; border-radius: 1.5px; background: #00d2ff;
            height: root.active ? (12px + 15px * Math.abs(Math.sin(root.anim-phase * 1.0rad + 1.8rad))) : 5px;
            y: (38px - self.height) / 2; animate height { duration: 80ms; easing: ease-in-out; } }
        // Center Peak Bar
        Rectangle { width: 4px; border-radius: 2px; background: #ffffff;
            height: root.active ? (16px + 20px * Math.abs(Math.sin(root.anim-phase * 1.0rad + 2.4rad))) : 6px;
            y: (38px - self.height) / 2; animate height { duration: 80ms; easing: ease-in-out; } }
        Rectangle { width: 3px; border-radius: 1.5px; background: #00d2ff;
            height: root.active ? (12px + 15px * Math.abs(Math.sin(root.anim-phase * 1.0rad + 3.0rad))) : 5px;
            y: (38px - self.height) / 2; animate height { duration: 80ms; easing: ease-in-out; } }
        Rectangle { width: 3px; border-radius: 1.5px; background: #38bdf8ee;
            height: root.active ? (10px + 12px * Math.abs(Math.sin(root.anim-phase * 1.0rad + 3.6rad))) : 4px;
            y: (38px - self.height) / 2; animate height { duration: 80ms; easing: ease-in-out; } }
        Rectangle { width: 3px; border-radius: 1.5px; background: #38bdf8cc;
            height: root.active ? (7px + 10px * Math.abs(Math.sin(root.anim-phase * 1.0rad + 4.2rad))) : 3px;
            y: (38px - self.height) / 2; animate height { duration: 80ms; easing: ease-in-out; } }
        Rectangle { width: 3px; border-radius: 1.5px; background: #38bdf8aa;
            height: root.active ? (5px + 7px * Math.abs(Math.sin(root.anim-phase * 1.0rad + 4.8rad))) : 3px;
            y: (38px - self.height) / 2; animate height { duration: 80ms; easing: ease-in-out; } }
    }
}


