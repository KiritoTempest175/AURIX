// ═══════════════════════════════════════════════════════════════════════════
//  LUNA  —  General Autonomous Desktop Executive Dashboard (Slint 1.8)
// ═══════════════════════════════════════════════════════════════════════════
import { LineEdit, ScrollView, Button } from "std-widgets.slint";
import { ReviewCard, ActionParam } from "components/review_card.slint";
import { AlertModal } from "components/alert_modal.slint";

export { ActionParam }

export struct ChatMessage {
    sender: string,
    text:   string,
    time:   string,
}

export struct CheckpointEntry {
    checkpoint_id: string,
    iso_time: string,
    step_count: int,
    eval_loss: string,
    lora_rank: int,
}

// ─────────────────────────────────────────────────────────────────────────────
//  COMPONENT: ModularCard  — rounded glassmorphism container
// ─────────────────────────────────────────────────────────────────────────────
component ModularCard inherits Rectangle {
    in property <string> title: "";
    in property <color>  card-bg: #0f172ae8;
    in property <color>  card-border: #1e293bcc;

    border-radius: 8px;
    border-width: 1px;
    border-color: root.card-border;
    background: root.card-bg;
    clip: false;
}

// ─────────────────────────────────────────────────────────────────────────────
//  COMPONENT: CleanMeter  — smooth animated progress bar
// ─────────────────────────────────────────────────────────────────────────────
component CleanMeter inherits Rectangle {
    in property <float> value: 0.0;
    in property <color> bar-color: #38bdf8;
    height: 6px;
    border-radius: 3px;
    background: #080f1d;
    clip: true;

    Rectangle {
        x: 0; y: 0;
        height: parent.height;
        border-radius: parent.border-radius;
        width: parent.width * Math.clamp(root.value, 0.0, 1.0);
        background: @linear-gradient(90deg, #0284c7 0%, root.bar-color 100%);
        animate width { duration: 400ms; easing: ease-out; }
    }
}

// ─────────────────────────────────────────────────────────────────────────────
//  COMPONENT: MetricTile  — top row hardware telemetry card
// ─────────────────────────────────────────────────────────────────────────────
component MetricTile inherits ModularCard {
    in property <string> label: "";
    in property <string> main-value: "";
    in property <string> sub-value: "";
    in property <float>  amount: 0.0;
    in property <color>  accent-color: #38bdf8;
    in property <string> tile-icon: "";

    height: 105px;
    card-bg: #0f172ae8;

    VerticalLayout {
        padding: 12px;
        spacing: 6px;

        HorizontalLayout {
            height: 16px;
            Text {
                text: root.tile-icon + " " + root.label;
                color: #64748b;
                font-size: 8.5px;
                font-weight: 700;
                letter-spacing: 0.8px;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: root.main-value;
                color: root.accent-color;
                font-size: 13px;
                font-weight: 800;
                vertical-alignment: center;
            }
        }

        CleanMeter {
            value: root.amount;
            bar-color: root.accent-color;
        }

        HorizontalLayout {
            height: 14px;
            Text {
                text: root.sub-value;
                color: #94a3b8;
                font-size: 8.5px;
                font-weight: 600;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: Math.round(root.amount * 100.0) + "%";
                color: #475569;
                font-size: 8.5px;
                font-weight: 700;
                vertical-alignment: center;
            }
        }
    }
}

// ─────────────────────────────────────────────────────────────────────────────
//  COMPONENT: VoiceOrb  — animated concentric AI core visualizer
// ─────────────────────────────────────────────────────────────────────────────
component VoiceOrb inherits Rectangle {
    in property <float> anim-phase: 0.0;
    in property <bool>  active: true;

    width: 220px; height: 220px;
    background: #00000000;

    Rectangle {
        x: 0; y: 0; width: 220px; height: 220px;
        border-radius: 110px;
        background: @radial-gradient(circle, #38bdf820 0%, #0284c70a 45%, #00000000 70%);
        opacity: root.active ? (0.6 + 0.4 * Math.sin(root.anim-phase * 1.0rad)) : 0.2;
        animate opacity { duration: 200ms; }
    }

    Rectangle {
        x: 6px; y: 6px; width: 208px; height: 208px;
        border-radius: 104px;
        border-width: 1px; border-color: #38bdf822;
        background: #00000000;
    }

    Rectangle {
        x: 24px; y: 24px; width: 172px; height: 172px;
        border-radius: 86px;
        border-width: 1.5px;
        border-color: root.active ? #38bdf855 : #1e293b66;
        background: @radial-gradient(circle, #38bdf810 0%, #00000000 60%);
        animate border-color { duration: 300ms; }
    }

    Rectangle {
        x: 55px; y: 55px; width: 110px; height: 110px;
        border-radius: 55px;
        border-width: 2px;
        border-color: root.active ? #38bdf8aa : #0284c744;
        background: @radial-gradient(circle, #0f172a, #030712);
        animate border-color { duration: 300ms; }
    }

    // Spectrum bars inside core
    HorizontalLayout {
        x: 75px; y: 92px; width: 70px; height: 36px;
        spacing: 3px; alignment: center;

        Rectangle { width: 3px; border-radius: 1.5px; background: #38bdf8aa;
            height: root.active ? (5px + 7px * Math.abs(Math.sin(root.anim-phase * 1.0rad + 0.0rad))) : 3px;
            y: (36px - self.height) / 2; animate height { duration: 80ms; } }
        Rectangle { width: 3px; border-radius: 1.5px; background: #38bdf8cc;
            height: root.active ? (8px + 11px * Math.abs(Math.sin(root.anim-phase * 1.0rad + 0.8rad))) : 3px;
            y: (36px - self.height) / 2; animate height { duration: 80ms; } }
        Rectangle { width: 4px; border-radius: 2px; background: #ffffff;
            height: root.active ? (14px + 18px * Math.abs(Math.sin(root.anim-phase * 1.0rad + 1.6rad))) : 5px;
            y: (36px - self.height) / 2; animate height { duration: 80ms; } }
        Rectangle { width: 3px; border-radius: 1.5px; background: #38bdf8cc;
            height: root.active ? (8px + 11px * Math.abs(Math.sin(root.anim-phase * 1.0rad + 2.4rad))) : 3px;
            y: (36px - self.height) / 2; animate height { duration: 80ms; } }
        Rectangle { width: 3px; border-radius: 1.5px; background: #38bdf8aa;
            height: root.active ? (5px + 7px * Math.abs(Math.sin(root.anim-phase * 1.0rad + 3.2rad))) : 3px;
            y: (36px - self.height) / 2; animate height { duration: 80ms; } }
    }
}

// ═══════════════════════════════════════════════════════════════════════════
//  MAIN APPLICATION DASHBOARD WINDOW
// ═══════════════════════════════════════════════════════════════════════════
export component AurixCommandCenter inherits Window {
    title:           "LUNA — JARVIS-Style Desktop Executive";
    preferred-width:  1380px;
    preferred-height: 840px;
    min-width:        960px;
    min-height:       620px;
    background:       #080c14;

    // ── Live Telemetry Properties ───────────────────────────────────────────
    in-out property <string> live-date:    "SAT, AUG 29, 2026";
    in-out property <string> live-time:    "10:02:01";
    in-out property <string> system-temp:  "38.4°C";
    in-out property <float>  temp-usage:   0.38;

    in-out property <float>  cpu-usage:    0.34;
    in-out property <string> cpu-display:  "34%";
    in-out property <string> ram-display:  "9.2 / 16 GB";
    in-out property <float>  ram-usage:    0.57;
    in-out property <string> vram-display: "3.4 / 8.0 GB";
    in-out property <float>  vram-usage:   0.42;

    in-out property <string> disk-display: "41%";
    in-out property <float>  disk-usage:   0.41;
    in-out property <string> ram-vram-display: "16 / 12";
    in-out property <string> budget-display:   "GB";
    in-out property <string> offline-mode:     "ENABLED";
    in-out property <string> resource-gov:     "NOMINAL";

    in-out property <string> uptime-display:       "00:00:00";
    in-out property <string> sessions-count:        "03";
    in-out property <string> commands-count:        "248";
    in-out property <float>  system-load:           0.28;
    in-out property <string> system-load-display:  "28%";

    in-out property <bool>   camera-active:    false;
    in-out property <bool>   microphone-active: true;
    in-out property <bool>   keyboard-active:  false;

    // ── LUNA Power Governor & Student Training Properties ───────────────────
    in-out property <string> power-state:       "ACTIVE";  // ACTIVE, IDLE, LOCKED, SUSPENDING
    in-out property <bool>   training-running:  false;
    in-out property <int>    training-step:     0;
    in-out property <int>    training-rank:     16;
    in-out property <string> training-loss:     "0.00";
    in-out property <bool>   wakeword-active:   true;

    in-out property <float>  anim-phase:        0.0;
    in-out property <string> message-text:      "";
    in-out property <string> toast-message:     "";
    in-out property <bool>   toast-visible:     false;
    in-out property <[ChatMessage]> messages: [
        { sender: "LUNA", text: "LUNA Executive initialized. Ready for voice or command instructions.", time: "" }
    ];

    // ── Checkpoint Browser State ────────────────────────────────────────────
    in-out property <bool> checkpoint-browser-visible: false;
    in-out property <[CheckpointEntry]> checkpoints: [];

    // ── Modal-state properties ───────────────────────────────────────────────
    in-out property <bool>   alert-modal-open:     false;
    in-out property <bool>   alert-modal-visible:  false;
    in-out property <string> alert-modal-title:    "Security Directive Alert";
    in-out property <string> alert-modal-subtitle: "SYSTEM MONITOR // PRIORITY OVERRIDE";
    in-out property <string> alert-modal-severity: "critical";
    in-out property <string> alert-modal-icon:     "⚠";
    in-out property <string> alert-modal-message:  "";
    in-out property <string> alert-modal-details-label:   "SECURITY TELEMETRY LOGS";
    in-out property <string> alert-modal-details-content: "";
    in-out property <string> alert-modal-primary-text:    "Acknowledge & Isolate";
    in-out property <string> alert-modal-secondary-text:  "Dismiss";

    in-out property <bool>   review-modal-open:        false;
    in-out property <bool>   review-card-visible:      false;
    in-out property <string> review-card-category:     "SYSTEM INTEGRITY";
    in-out property <string> review-card-title:        "Kernel Memory Alignment Check";
    in-out property <string> review-card-severity:     "warning";
    in-out property <string> review-card-status:       "REQUIRES REVIEW";
    in-out property <string> review-card-summary:      "";
    in-out property <string> review-card-details:      "";
    in-out property <string> review-card-meta-id:      "REV-4089";
    in-out property <string> review-card-meta-time:    "03:34:12";
    in-out property <string> review-card-meta-source:  "HEURISTICS_V2";
    in-out property <string> review-card-primary-text: "Approve Fix";
    in-out property <string> review-card-secondary-text: "Dismiss";

    // ── Callbacks ────────────────────────────────────────────────────────────
    callback send-message(string);
    callback toggle-training();
    callback open-checkpoint-browser();
    callback restore-checkpoint(string);
    callback clear-conversation();
    callback export-conversation();
    callback trigger-voice();

    callback alert-primary-action();
    callback alert-secondary-action();
    callback alert-modal-closed();
    callback review-primary-action();
    callback review-secondary-action();
    callback review-modal-closed();

    callback review-approve();
    callback review-edit();
    callback review-reject();
    callback alert-retry();
    callback alert-cancel();
    callback alert-close();

    Timer {
        interval: 33ms;
        running: true;
        triggered => {
            root.anim-phase = root.anim-phase + 0.08;
        }
    }

    VerticalLayout {
        width: 100%; height: 100%; spacing: 0;

        // ════════════════════════════════════════════════════════════════════
        //  1. TOP NAVIGATION & STATUS HEADER
        // ════════════════════════════════════════════════════════════════════
        Rectangle {
            height: 56px;
            background: #0b1320f6;

            Rectangle {
                y: 55px; width: 100%; height: 1px;
                background: @linear-gradient(90deg, #1e293b00 0%, #38bdf855 50%, #1e293b00 100%);
            }

            HorizontalLayout {
                width: 100%; height: 100%;
                padding-left: 24px; padding-right: 24px;
                spacing: 16px;

                // Brand Identity (Left)
                HorizontalLayout {
                    spacing: 12px; alignment: center;
                    Rectangle {
                        width: 34px; height: 34px; border-radius: 6px;
                        border-width: 1px; border-color: #38bdf855;
                        background: #38bdf814;
                        Text {
                            text: "◆"; color: #38bdf8; font-size: 16px; font-weight: 900;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                    }
                    VerticalLayout {
                        spacing: 1px; alignment: center;
                        Text {
                            text: "LUNA"; color: #ffffff;
                            font-size: 15px; font-weight: 800; letter-spacing: 2px;
                        }
                        Text {
                            text: "AUTONOMOUS EXECUTIVE"; color: #38bdf8;
                            font-size: 8px; font-weight: 700; letter-spacing: 1px;
                        }
                    }

                    Rectangle { width: 6px; }

                    // Power State Badge
                    Rectangle {
                        height: 22px; width: 90px; border-radius: 4px;
                        border-width: 1px;
                        border-color: root.power-state == "ACTIVE" ? #38bdf855 : (root.power-state == "IDLE" ? #10b98155 : #f59e0b55);
                        background: root.power-state == "ACTIVE" ? #38bdf818 : (root.power-state == "IDLE" ? #10b98118 : #f59e0b18);
                        HorizontalLayout {
                            alignment: center; spacing: 5px;
                            Rectangle {
                                width: 6px; height: 6px; border-radius: 3px;
                                background: root.power-state == "ACTIVE" ? #38bdf8 : (root.power-state == "IDLE" ? #10b981 : #f59e0b);
                                y: (parent.height - self.height) / 2;
                            }
                            Text {
                                text: root.power-state;
                                color: root.power-state == "ACTIVE" ? #38bdf8 : (root.power-state == "IDLE" ? #10b981 : #f59e0b);
                                font-size: 9px; font-weight: 800; letter-spacing: 0.6px; vertical-alignment: center;
                            }
                        }
                    }

                    // Wake-Word Dot
                    Rectangle {
                        height: 22px; width: 140px; border-radius: 4px;
                        border-width: 1px; border-color: #10b98144; background: #10b98114;
                        HorizontalLayout {
                            alignment: center; spacing: 6px;
                            Rectangle {
                                width: 6px; height: 6px; border-radius: 3px; background: #10b981;
                                opacity: 0.6 + 0.4 * Math.sin(root.anim-phase * 1.2rad);
                                y: (parent.height - self.height) / 2;
                            }
                            Text {
                                text: "WAKE-WORD: 'LUNA'"; color: #a7f3d0;
                                font-size: 8px; font-weight: 700; letter-spacing: 0.5px; vertical-alignment: center;
                            }
                        }
                    }
                }

                Rectangle { horizontal-stretch: 1; }

                // Clock (Center)
                VerticalLayout {
                    alignment: center; spacing: 2px;
                    HorizontalLayout {
                        spacing: 8px; alignment: center;
                        Text { text: root.live-date; color: #94a3b8; font-size: 10px; font-weight: 600; }
                        Text { text: "•"; color: #334155; font-size: 10px; }
                        Text { text: root.live-time; color: #38bdf8; font-size: 16px; font-weight: 800; letter-spacing: 1px; }
                    }
                }

                Rectangle { horizontal-stretch: 1; }

                // Checkpoints & Admin Profile (Right)
                HorizontalLayout {
                    spacing: 10px; alignment: center;

                    // Checkpoints Button
                    Rectangle {
                        height: 32px; width: 120px; border-radius: 5px;
                        border-width: 1px; border-color: #334155; background: #0f172a;
                        HorizontalLayout {
                            alignment: center; spacing: 6px;
                            Text { text: "⛁"; color: #38bdf8; font-size: 11px; vertical-alignment: center; }
                            Text { text: "CHECKPOINTS"; color: #cbd5e1; font-size: 8.5px; font-weight: 700; vertical-alignment: center; }
                        }
                        TouchArea { clicked => { root.open-checkpoint-browser(); } }
                    }

                    // Admin Chip
                    Rectangle {
                        height: 32px; width: 100px; border-radius: 5px;
                        border-width: 1px; border-color: #38bdf844; background: #38bdf810;
                        HorizontalLayout {
                            alignment: center; spacing: 6px;
                            Text { text: "●"; color: #10b981; font-size: 8px; vertical-alignment: center; }
                            Text { text: "OPERATOR"; color: #f1f5f9; font-size: 9px; font-weight: 700; vertical-alignment: center; }
                        }
                    }
                }
            }
        }

        // ════════════════════════════════════════════════════════════════════
        //  2. TELEMETRY & METRIC TILES ROW
        // ════════════════════════════════════════════════════════════════════
        VerticalLayout {
            vertical-stretch: 1;
            padding-left: 24px; padding-right: 24px;
            padding-top: 14px; padding-bottom: 14px;
            spacing: 14px;

            HorizontalLayout {
                height: 105px;
                spacing: 14px;

                MetricTile {
                    horizontal-stretch: 1;
                    tile-icon: "●";
                    label: "CPU UTILIZATION";
                    main-value: root.cpu-display;
                    sub-value: "CORE LOAD NOMINAL";
                    amount: root.cpu-usage;
                    accent-color: #38bdf8;
                }

                MetricTile {
                    horizontal-stretch: 1;
                    tile-icon: "●";
                    label: "HOST RAM (14.5 GB CEILING)";
                    main-value: root.ram-display;
                    sub-value: "ACTIVE MEMORY LOAD";
                    amount: root.ram-usage;
                    accent-color: #0284c7;
                }

                MetricTile {
                    horizontal-stretch: 1;
                    tile-icon: "●";
                    label: "GPU VRAM (7.0 GB CEILING)";
                    main-value: root.vram-display;
                    sub-value: "RTX 4060 NF4 QUANT";
                    amount: root.vram-usage;
                    accent-color: #10b981;
                }

                MetricTile {
                    horizontal-stretch: 1;
                    tile-icon: "●";
                    label: "GPU TEMPERATURE";
                    main-value: root.system-temp;
                    sub-value: "THERMAL LIMIT: 82°C";
                    amount: root.temp-usage;
                    accent-color: #f59e0b;
                }
            }

            // ════════════════════════════════════════════════════════════════
            //  3. MAIN SPLIT: ASSISTANT CORE & CHAT CONSOLE
            // ════════════════════════════════════════════════════════════════
            HorizontalLayout {
                vertical-stretch: 1;
                spacing: 14px;

                // ── LEFT: VOICE INTERFACE & STUDENT-5B TRAINING TOGGLE ──
                ModularCard {
                    min-width: 330px;
                    horizontal-stretch: 35;
                    vertical-stretch: 1;

                    VerticalLayout {
                        width: 100%; height: 100%;
                        padding: 16px; spacing: 12px;

                        // Header
                        HorizontalLayout {
                            height: 18px;
                            HorizontalLayout {
                                spacing: 6px; alignment: center;
                                Rectangle { width: 7px; height: 7px; border-radius: 3.5px; background: #10b981; }
                                Text {
                                    text: "GEMMA 3n E4B + STUDENT-5B";
                                    color: #f1f5f9; font-size: 9.5px; font-weight: 800; letter-spacing: 0.6px;
                                }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            Text { text: "LUNA.v0.2"; color: #38bdf8; font-size: 9px; font-weight: 700; }
                        }

                        // Concentric Orb
                        VerticalLayout {
                            vertical-stretch: 1;
                            alignment: center; spacing: 10px;

                            VoiceOrb {
                                anim-phase: root.anim-phase;
                                active: true;
                                horizontal-stretch: 0;
                            }

                            // Training Controls Box
                            Rectangle {
                                width: 280px; height: 85px; border-radius: 6px;
                                border-width: 1px;
                                border-color: root.training-running ? #10b98155 : #334155;
                                background: root.training-running ? #10b98110 : #090e17;

                                VerticalLayout {
                                    padding: 10px; spacing: 6px;

                                    HorizontalLayout {
                                        Text {
                                            text: "STUDENT-5B QLORA";
                                            color: root.training-running ? #34d399 : #94a3b8;
                                            font-size: 8px; font-weight: 800; letter-spacing: 0.6px;
                                            vertical-alignment: center;
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                        Text {
                                            text: "Step " + root.training-step + " | Rank " + root.training-rank;
                                            color: #cbd5e1; font-size: 8px; font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                    }

                                    // Big Start / Stop Training Toggle Button
                                    Rectangle {
                                        height: 32px; border-radius: 4px;
                                        background: root.training-running ? #ef4444 : #0284c7;
                                        HorizontalLayout {
                                            alignment: center; spacing: 6px;
                                            Text {
                                                text: root.training-running ? "⏹ STOP TRAINING" : "▶ START CONTINUOUS TRAINING";
                                                color: #ffffff; font-size: 9.5px; font-weight: 800; letter-spacing: 0.8px;
                                                vertical-alignment: center;
                                            }
                                        }
                                        TouchArea { clicked => { root.toggle-training(); } }
                                    }
                                }
                            }
                        }
                    }
                }

                // ── RIGHT: CONVERSATION & COMMAND EXECUTION CONSOLE ──
                ModularCard {
                    min-width: 480px;
                    horizontal-stretch: 65;
                    vertical-stretch: 1;

                    VerticalLayout {
                        width: 100%; height: 100%;
                        padding: 16px; spacing: 10px;

                        // Header Toolbar
                        HorizontalLayout {
                            height: 24px;
                            HorizontalLayout {
                                spacing: 8px; alignment: center;
                                Text { text: "▶"; color: #38bdf8; font-size: 11px; vertical-alignment: center; }
                                Text {
                                    text: "LUNA INTELLIGENCE CONSOLE";
                                    color: #f1f5f9; font-size: 10px; font-weight: 800; letter-spacing: 0.6px;
                                    vertical-alignment: center;
                                }
                            }

                            Rectangle { horizontal-stretch: 1; }

                            HorizontalLayout {
                                spacing: 8px; alignment: center;
                                Rectangle {
                                    width: 78px; height: 24px; border-radius: 4px;
                                    border-width: 1px; border-color: #334155; background: #1e293b66;
                                    Text {
                                        text: "CLEAR"; color: #94a3b8;
                                        font-size: 8px; font-weight: 700;
                                        horizontal-alignment: center; vertical-alignment: center;
                                    }
                                    TouchArea { clicked => { root.clear-conversation(); } }
                                }
                                Rectangle {
                                    width: 78px; height: 24px; border-radius: 4px;
                                    border-width: 1px; border-color: #334155; background: #1e293b66;
                                    Text {
                                        text: "EXPORT"; color: #94a3b8;
                                        font-size: 8px; font-weight: 700;
                                        horizontal-alignment: center; vertical-alignment: center;
                                    }
                                    TouchArea { clicked => { root.export-conversation(); } }
                                }
                            }
                        }

                        // Message History
                        ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                padding: 4px; spacing: 10px;

                                for msg in root.messages: HorizontalLayout {
                                    spacing: 10px; alignment: start;

                                    Rectangle {
                                        width: 26px; height: 26px; border-radius: 6px;
                                        border-width: 1px;
                                        border-color: msg.sender == "USER" ? #38bdf855 : #10b98155;
                                        background: msg.sender == "USER" ? #38bdf818 : #0f172a;
                                        vertical-stretch: 0;
                                        Text {
                                            text: msg.sender == "USER" ? "U" : "L";
                                            font-size: 11px; font-weight: 800;
                                            color: msg.sender == "USER" ? #38bdf8 : #34d399;
                                            horizontal-alignment: center; vertical-alignment: center;
                                        }
                                    }

                                    Rectangle {
                                        horizontal-stretch: 1;
                                        border-radius: 6px;
                                        background: msg.sender == "USER" ? #0284c718 : #1e293b88;
                                        border-width: 1px;
                                        border-color: msg.sender == "USER" ? #0284c744 : #334155;

                                        VerticalLayout {
                                            padding: 10px; spacing: 4px;
                                            Text {
                                                text: msg.sender;
                                                color: msg.sender == "USER" ? #38bdf8 : #34d399;
                                                font-size: 8px; font-weight: 800; letter-spacing: 0.6px;
                                            }
                                            Text {
                                                text: msg.text;
                                                color: #f1f5f9;
                                                font-size: 11px;
                                                wrap: word-wrap;
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Input Bar
                        Rectangle {
                            height: 42px; border-radius: 6px;
                            border-width: 1px; border-color: #334155; background: #090e17;

                            HorizontalLayout {
                                padding-left: 10px; padding-right: 8px;
                                padding-top: 4px; padding-bottom: 4px;
                                spacing: 8px;

                                Rectangle {
                                    horizontal-stretch: 1;
                                    LineEdit {
                                        width: 100%; height: 100%;
                                        text <=> root.message-text;
                                        placeholder-text: "Ask LUNA or provide command instructions...";
                                        font-size: 11px;
                                        accepted => {
                                            if root.message-text != "" {
                                                root.send-message(root.message-text);
                                                root.message-text = "";
                                            }
                                        }
                                    }
                                }

                                // Voice / Mic Button
                                Rectangle {
                                    width: 54px; height: 34px; border-radius: 6px;
                                    border-width: 1px;
                                    border-color: root.microphone-active ? #10b981 : #334155;
                                    background: root.microphone-active ? #10b98122 : #1e293b66;
                                    y: (parent.height - self.height) / 2;
                                    HorizontalLayout {
                                        alignment: center; spacing: 4px;
                                        Rectangle {
                                            width: 6px; height: 6px; border-radius: 3px;
                                            background: root.microphone-active ? #10b981 : #64748b;
                                            y: (parent.height - self.height) / 2;
                                        }
                                        Text {
                                            text: "VOICE";
                                            color: root.microphone-active ? #10b981 : #94a3b8;
                                            font-size: 8.5px; font-weight: 800;
                                            vertical-alignment: center;
                                        }
                                    }
                                    TouchArea {
                                        clicked => {
                                            root.trigger-voice();
                                        }
                                    }
                                }

                                // Send Button
                                Rectangle {
                                    width: 48px; height: 34px; border-radius: 6px;
                                    background: #0284c7;
                                    y: (parent.height - self.height) / 2;
                                    HorizontalLayout {
                                        alignment: center; spacing: 4px;
                                        Text {
                                            text: "SEND";
                                            color: #ffffff;
                                            font-size: 9px; font-weight: 800;
                                            vertical-alignment: center;
                                        }
                                    }
                                    TouchArea {
                                        clicked => {
                                            if root.message-text != "" {
                                                root.send-message(root.message-text);
                                                root.message-text = "";
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // ════════════════════════════════════════════════════════════════════
        //  TOAST MESSAGE
        // ════════════════════════════════════════════════════════════════════
        if root.toast-visible: Rectangle {
            height: 36px;
            background: #38bdf818;
            border-width: 1px; border-color: #38bdf855;
            HorizontalLayout {
                padding-left: 18px; spacing: 8px; alignment: center;
                Rectangle { width: 6px; height: 6px; border-radius: 3px; background: #10b981; y: (parent.height - self.height) / 2; }
                Text { text: root.toast-message; color: #bae6fd; font-size: 10px; font-weight: 600; vertical-alignment: center; }
            }
        }
    }

    // ════════════════════════════════════════════════════════════════════
    //  CHECKPOINT BROWSER MODAL OVERLAY
    // ════════════════════════════════════════════════════════════════════
    if root.checkpoint-browser-visible: Rectangle {
        width: 100%; height: 100%;
        background: #000000cc;
        z: 50;

        TouchArea { clicked => { root.checkpoint-browser-visible = false; } }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: Math.min(parent.width - 60px, 680px);
            height: 440px;
            border-radius: 8px;
            border-width: 1px; border-color: #38bdf855;
            background: #0f172a;

            VerticalLayout {
                padding: 18px; spacing: 12px;

                HorizontalLayout {
                    Text { text: "⛁ LUNA Checkpoint Browser"; color: #ffffff; font-size: 13px; font-weight: 800; }
                    Rectangle { horizontal-stretch: 1; }
                    Rectangle {
                        width: 24px; height: 24px; border-radius: 12px; background: #1e293b;
                        Text { text: "✕"; color: #94a3b8; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.checkpoint-browser-visible = false; } }
                    }
                }

                Text {
                    text: "Select a versioned checkpoint to restore. Restoring requires Trust Token confirmation.";
                    color: #94a3b8; font-size: 9px;
                }

                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 8px;
                        for ckpt in root.checkpoints: Rectangle {
                            height: 52px; border-radius: 6px;
                            border-width: 1px; border-color: #334155; background: #1e293b66;
                            HorizontalLayout {
                                padding-left: 12px; padding-right: 12px; spacing: 10px; alignment: center;
                                VerticalLayout {
                                    horizontal-stretch: 1; alignment: center; spacing: 2px;
                                    Text { text: ckpt.checkpoint-id; color: #38bdf8; font-size: 10px; font-weight: 700; }
                                    Text { text: "Saved: " + ckpt.iso-time + " | Step " + ckpt.step-count + " | Loss: " + ckpt.eval-loss; color: #64748b; font-size: 8px; }
                                }
                                Rectangle {
                                    width: 80px; height: 28px; border-radius: 4px;
                                    background: #0284c7;
                                    Text { text: "RESTORE"; color: #ffffff; font-size: 8.5px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                                    TouchArea {
                                        clicked => {
                                            root.checkpoint-browser-visible = false;
                                            root.restore-checkpoint(ckpt.checkpoint-id);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // ── Review Card Overlay (Trust Token Confirmation) ───────────────────────
    if root.review-card-visible: Rectangle {
        width: 100%; height: 100%; background: #000000bb; z: 30;
        TouchArea { clicked => { root.review-card-visible = false; } }
        ReviewCard {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: Math.min(parent.width - 40px, 640px);
            approve => { root.review-card-visible = false; root.review-approve(); }
            edit => { root.review-edit(); }
            reject => { root.review-card-visible = false; root.review-reject(); }
        }
    }

    // ── Alert Modal Overlay (Self-Healing 5s Countdown) ─────────────────────
    if root.alert-modal-visible: AlertModal {
        z: 40;
        retry => { root.alert-modal-visible = false; root.alert-retry(); }
        cancel => { root.alert-modal-visible = false; root.alert-cancel(); }
        close => { root.alert-modal-visible = false; root.alert-close(); }
    }
}
