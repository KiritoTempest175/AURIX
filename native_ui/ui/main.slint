                        width: 34px; height: 34px; border-radius: 6px;
                        border-width: 1px; border-color: #00d2ff55;
                        background: #00d2ff14;
                        Text {
                            text: "◎"; color: #00d2ff; font-size: 16px;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                    }
                    VerticalLayout {
                        spacing: 1px; alignment: center;
                        Text {
                            text: "A.U.R.I.X"; color: #ffffff;
                            font-size: 15px; font-weight: 800; letter-spacing: 2px;
                        }
                        Text {
                            text: "CLEAN MODULAR AI DASHBOARD"; color: #00d2ff;
                            font-size: 8px; font-weight: 700; letter-spacing: 1px;
                        }
                    }

                    Rectangle { width: 8px; }

                    // Live Status Badge
                    Rectangle {
                        height: 22px; width: 78px; border-radius: 4px;
                        border-width: 1px; border-color: #10b98155;
                        background: #10b98118;
                        HorizontalLayout {
                            alignment: center; spacing: 5px;
                            Rectangle { width: 6px; height: 6px; border-radius: 3px; background: #10b981; y: (parent.height - self.height) / 2; }
                            Text { text: "ONLINE"; color: #10b981; font-size: 9px; font-weight: 800; letter-spacing: 0.6px; vertical-alignment: center; }
                        }
                    }
                }

                Rectangle { horizontal-stretch: 1; }

                // System Status & Digital Clock (Center)
                VerticalLayout {
                    alignment: center; spacing: 2px;
                    HorizontalLayout {
                        spacing: 6px; alignment: center;
                        Rectangle { width: 5px; height: 5px; border-radius: 2.5px; background: #10b981; }
                        Text {
                            text: "SYSTEM STATUS: NOMINAL  //  ALL SERVICES OPERATIONAL";
                            color: #64748b; font-size: 8.5px; font-weight: 700; letter-spacing: 0.8px;
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px; alignment: center;
                        Text { text: root.live-date; color: #94a3b8; font-size: 10px; font-weight: 600; }
                        Text { text: "•"; color: #334155; font-size: 10px; }
                        Text { text: root.live-time; color: #00d2ff; font-size: 16px; font-weight: 800; letter-spacing: 1px; }
                    }
                }

                Rectangle { horizontal-stretch: 1; }

                // Right Profile & Telemetry Chip
                HorizontalLayout {
                    spacing: 10px; alignment: center;

                    // Temp Chip
                    Rectangle {
                        height: 34px; width: 110px; border-radius: 6px;
                        border-width: 1px; border-color: #334155; background: #0f172a;
                        VerticalLayout {
                            padding: 3px; alignment: center; spacing: 0;
                            Text { text: "CPU THERMALS"; color: #64748b; font-size: 7.5px; font-weight: 700; letter-spacing: 0.6px; horizontal-alignment: center; }
                            Text { text: root.system-temp; color: #00d2ff; font-size: 12px; font-weight: 800; horizontal-alignment: center; }
                        }
                    }

                    // Admin Pill
                    Rectangle {
                        height: 34px; width: 100px; border-radius: 6px;
                        border-width: 1px; border-color: #00d2ff44; background: #00d2ff10;
                        HorizontalLayout {
                            padding-left: 10px; padding-right: 10px; spacing: 6px; alignment: center;
                            Text { text: "👤"; color: #00d2ff; font-size: 11px; vertical-alignment: center; }
                            Text { text: "SYS_ADMIN"; color: #f1f5f9; font-size: 9px; font-weight: 700; letter-spacing: 0.5px; vertical-alignment: center; }
                        }
                    }
                }
            }
        }

        // ════════════════════════════════════════════════════════════════════
        //  MAIN DASHBOARD CONTAINER (FULL VIEWPORT WIDTH & RESPONSIVE)
        // ════════════════════════════════════════════════════════════════════
        VerticalLayout {
            vertical-stretch: 1;
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 16px;
            padding-bottom: 16px;
            spacing: 16px;

            // ────────────────────────────────────────────────────────
            //  2. TOP ROW: 3 ACCURATE HARDWARE TELEMETRY CARDS
            // ────────────────────────────────────────────────────────
            HorizontalLayout {
                height: 105px;
                spacing: 16px;

                // TILE 1: CPU USAGE
                MetricTile {
                    horizontal-stretch: 1;
                    tile-icon: "⌁";
                    label: "CPU UTILIZATION";
                    main-value: root.cpu-display;
                    sub-value: "SYSTEM LOAD: " + root.system-load-display;
                    amount: root.cpu-usage;
                    accent-color: #00d2ff;
                }

                // TILE 2: CPU TEMPERATURE
                MetricTile {
                    horizontal-stretch: 1;
                    tile-icon: "🌡";
                    label: "CPU TEMPERATURE";
                    main-value: root.system-temp;
                    sub-value: "THERMAL STATUS: NOMINAL";
                    amount: root.temp-usage;
                    accent-color: #10b981;
                }

                // TILE 3: RAM UTILIZATION
                MetricTile {
                    horizontal-stretch: 1;
                    tile-icon: "⊕";
                    label: "RAM UTILIZATION";
                    main-value: root.ram-display;
                    sub-value: "MEMORY LOAD: " + Math.round(root.ram-usage * 100.0) + "%";
                    amount: root.ram-usage;
                    accent-color: #38bdf8;
                }
            }

            // ────────────────────────────────────────────────────────
            //  3. BOTTOM SECTION: VOICE CONTROLS & AI CHAT CONSOLE
            // ────────────────────────────────────────────────────────
            HorizontalLayout {
                vertical-stretch: 1;
                spacing: 16px;

                // ── MODULAR CARD: VOICE CORE & ASSISTANT CONTROLS (~38% width) ──
                ModularCard {
                    min-width: 320px;
                    horizontal-stretch: 38;
                    vertical-stretch: 1;

                    VerticalLayout {
                        width: 100%; height: 100%;
                        padding: 18px; spacing: 12px;

                        // Header
                        HorizontalLayout {
                            height: 18px;
                            HorizontalLayout {
                                spacing: 6px; alignment: center;
                                Rectangle {
                                    width: 7px; height: 7px; border-radius: 3.5px;
                                    background: root.microphone-active ? #10b981 : #ef4444;
                                }
                                Text {
                                    text: "VOICE INTERFACE & AI CORE";
                                    color: #f1f5f9; font-size: 10px; font-weight: 800; letter-spacing: 0.6px;
                                }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            Text { text: "AUR-IX.04"; color: #00d2ff; font-size: 10px; font-weight: 700; }
                        }

                        // Centered Animated Orb
                        VerticalLayout {
                            vertical-stretch: 1;
                            alignment: center; spacing: 12px;

                            VoiceOrb {
                                anim-phase: root.anim-phase;
                                active: root.microphone-active;
                                horizontal-stretch: 0;
                            }

                            VerticalLayout {
                                spacing: 2px; alignment: center;
                                Text {
                                    text: "A.U.R.I.X"; color: #ffffff;
                                    font-size: 18px; font-weight: 900; letter-spacing: 4px;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: "NEURAL REASONING ENGINE"; color: #64748b;
                                    font-size: 8px; font-weight: 700; letter-spacing: 1.5px;
                                    horizontal-alignment: center;
                                }
                            }

                            // Status Pill
                            Rectangle {
                                width: 250px; height: 28px; border-radius: 14px;
                                border-width: 1px;
                                border-color: root.microphone-active ? #00d2ff55 : #ef444444;
                                background: root.microphone-active ? #00d2ff14 : #ef444414;
                                HorizontalLayout {
                                    padding-left: 12px; padding-right: 12px; spacing: 8px; alignment: center;
                                    Text { text: "🎙"; color: root.microphone-active ? #00d2ff : #f87171; font-size: 11px; vertical-alignment: center; }
                                    Rectangle {
                                        width: 6px; height: 6px; border-radius: 3px;
                                        background: root.microphone-active ? #10b981 : #ef4444;
                                        y: (parent.height - self.height) / 2;
                                        opacity: root.microphone-active ? (0.5 + 0.5 * Math.sin(root.anim-phase * 1.0rad)) : 1.0;
                                    }
                                    Text {
                                        text: root.microphone-active ? "Awaiting voice command..." : "Microphone muted";
                                        color: root.microphone-active ? #bae6fd : #fca5a5;
                                        font-size: 9.5px; font-weight: 600; vertical-alignment: center;
                                    }
                                }
                            }

                            // Media Toggles
                            HorizontalLayout {
                                spacing: 10px; alignment: center;
                                ControlToggle { icon: "◉"; label: "CAM"; active: root.camera-active; clicked => { root.camera-active = !root.camera-active; } }
                                ControlToggle { icon: "♩"; label: "MIC"; active: root.microphone-active; clicked => { root.microphone-active = !root.microphone-active; } }
                                ControlToggle { icon: "⌨"; label: "INPUT"; active: root.keyboard-active; clicked => { root.keyboard-active = !root.keyboard-active; } }
                            }
                        }
                    }
                }

                // ── MODULAR CARD: AI CHAT & COMMAND LOG CONSOLE (~62% width) ──
                ModularCard {
                    min-width: 480px;
                    horizontal-stretch: 62;
                    vertical-stretch: 1;

                            VerticalLayout {
                                width: 100%; height: 100%;
                                padding: 18px; spacing: 12px;

                                // Header Toolbar
                                HorizontalLayout {
                                    height: 24px;
                                    HorizontalLayout {
                                        spacing: 8px; alignment: center;
                                        Text { text: "💬"; font-size: 13px; vertical-alignment: center; }
                                        Text {
                                            text: "AI COMMAND LOG & CONVERSATION";
                                            color: #f1f5f9; font-size: 10.5px; font-weight: 800; letter-spacing: 0.6px;
                                            vertical-alignment: center;
                                        }
                                    }

                                    Rectangle { horizontal-stretch: 1; }

                                    // Action Buttons
                                    HorizontalLayout {
                                        spacing: 8px; alignment: center;

                                        Rectangle {
                                            width: 82px; height: 24px; border-radius: 4px;
                                            border-width: 1px; border-color: #334155; background: #1e293b66;
                                            Text {
                                                text: "CLEAR CHAT"; color: #94a3b8;
                                                font-size: 8px; font-weight: 700; letter-spacing: 0.5px;
                                                horizontal-alignment: center; vertical-alignment: center;
                                            }
                                            TouchArea { clicked => { root.clear-conversation(); } }
                                        }

                                        Rectangle {
                                            width: 86px; height: 24px; border-radius: 4px;
                                            border-width: 1px; border-color: #334155; background: #1e293b66;
                                            Text {
                                                text: "EXPORT LOG"; color: #94a3b8;
                                                font-size: 8px; font-weight: 700; letter-spacing: 0.5px;
                                                horizontal-alignment: center; vertical-alignment: center;
                                            }
                                            TouchArea { clicked => { root.export-conversation(); } }
                                        }
                                    }
                                }

                                // Message History Scroll Area
                                ScrollView {
                                    vertical-stretch: 1;
                                    VerticalLayout {
                                        padding: 4px; spacing: 10px;

                                        for msg in root.messages: HorizontalLayout {
                                            spacing: 10px; alignment: start;

                                            // Avatar icon
                                            Rectangle {
                                                width: 26px; height: 26px; border-radius: 6px;
                                                border-width: 1px;
                                                border-color: msg.sender == "USER" ? #00d2ff55 : #38bdf855;
                                                background: msg.sender == "USER" ? #00d2ff18 : #0f172a;
                                                vertical-stretch: 0;
                                                Text {
                                                    text: msg.sender == "USER" ? "👤" : "⬡";
                                                    color: msg.sender == "USER" ? #00d2ff : #38bdf8;
                                                    font-size: 11px;
                                                    horizontal-alignment: center; vertical-alignment: center;
                                                }
                                            }

                                            // Message Bubble
                                            Rectangle {
                                                horizontal-stretch: 1;
                                                border-radius: 6px;
                                                background: msg.sender == "USER" ? #0284c718 : #1e293b88;
                                                border-width: 1px;
                                                border-color: msg.sender == "USER" ? #0284c744 : #334155;

                                                VerticalLayout {
                                                    padding: 10px;
                                                    spacing: 4px;
                                                    HorizontalLayout {
                                                        Text {
                                                            text: msg.sender;
                                                            color: msg.sender == "USER" ? #38bdf8 : #00d2ff;
                                                            font-size: 8.5px; font-weight: 800; letter-spacing: 0.6px;
                                                        }
                                                    }
                                                    Text {
                                                        text: msg.text;
                                                        color: #f1f5f9;
                                                        font-size: 11px;
                                                        wrap: word-wrap;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }

                                // Command Line Input Bar
                                Rectangle {
                                    height: 40px; border-radius: 6px;
                                    border-width: 1px; border-color: #334155; background: #090e17;

                                    HorizontalLayout {
                                        padding-left: 10px; padding-right: 8px;
                                        padding-top: 4px; padding-bottom: 4px;
                                        spacing: 8px;

                                        Rectangle {
                                            horizontal-stretch: 1;
                                            LineEdit {
                                                width: 100%; height: 100%;
                                                text <=> root.message-text;
                                                placeholder-text: "Type a command or ask AURIX anything...";
                                                font-size: 11px;
                                                accepted => {
                                                    if root.message-text != "" {
                                                        root.send-message(root.message-text);
                                                        root.message-text = "";
                                                    }
                                                }
                                            }
                                        }

                                        Rectangle {
                                            width: 32px; height: 32px; border-radius: 6px;
                                            background: #0284c7;
                                            y: (parent.height - self.height) / 2;
                                            Text {
                                                text: "➤"; color: #ffffff; font-size: 12px;
                                                horizontal-alignment: center; vertical-alignment: center;
                                            }
                                            TouchArea {
                                                clicked => {
                                                    if root.message-text != "" {
                                                        root.send-message(root.message-text);
                                                        root.message-text = "";
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

        // ════════════════════════════════════════════════════════════════════
        //  TOAST NOTIFICATION
        // ════════════════════════════════════════════════════════════════════
        if root.toast-visible : Rectangle {
            height: 36px;
            background: #00d2ff18;
            border-width: 1px; border-color: #00d2ff55;
            HorizontalLayout {
                padding-left: 18px; spacing: 8px; alignment: center;
                Rectangle { width: 6px; height: 6px; border-radius: 3px; background: #10b981; y: (parent.height - self.height) / 2; }
                Text { text: root.toast-message; color: #bae6fd; font-size: 10px; font-weight: 600; vertical-alignment: center; }
            }
        }
    }

    // Review Card Overlay (Approval Modal Dialog)
    if root.review-card-visible: Rectangle {
        width: 100%;
        height: 100%;
        background: #000000bb;
        z: 30;

        // Dismiss when clicking outside
        TouchArea {
            clicked => { root.review-card-visible = false; }
        }

        ReviewCard {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: Math.min(parent.width - 40px, 640px);
            approve => {
                root.review-card-visible = false;
                root.review-approve();
            }
            edit => {
                root.review-edit();
            }
            reject => {
                root.review-card-visible = false;
                root.review-reject();
            }
        }
    }

    // Alert Modal Overlay (Self-Healing Modal Dialog)
    if root.alert-modal-visible: AlertModal {
        z: 40;
        retry => {
            root.alert-modal-visible = false;
            root.alert-retry();
        }
        cancel => {
            root.alert-modal-visible = false;
            root.alert-cancel();
        }
        close => {
            root.alert-modal-visible = false;
            root.alert-close();
        }
    }
}
