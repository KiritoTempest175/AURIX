// A.U.R.I.X Command Center — Pixel-faithful, fully responsive fullscreen layout.
import { LineEdit, ScrollView } from "std-widgets.slint";

export struct ChatMessage {
    sender: string,
    text: string,
    time: string,
}

// ─── Reusable Components ────────────────────────────────────────────────────

component Meter inherits Rectangle {
    in property <float> value;
    height: 6px;
    border-radius: 3px;
    background: #12303e;
    Rectangle {
        width: parent.width * Math.clamp(root.value, 0.0, 1.0);
        height: parent.height;
        border-radius: 3px;
        background: @linear-gradient(90deg, #1894a8, #4dd8e8);
        animate width { duration: 500ms; easing: ease-out; }
    }
}

component SidePanel inherits Rectangle {
    border-radius: 14px;
    border-width: 1px;
    border-color: #1d3a4a66;
    background: #0c1a26e8;
}

component StatRow inherits VerticalLayout {
    in property <string> label;
    in property <string> display-value;
    in property <float> amount;
    spacing: 4px;
    Rectangle {
        height: 26px;
        background: #00000000;
        Rectangle { y: parent.height - 1px; width: 100%; height: 1px; background: #1d3a4a33; }
        HorizontalLayout {
            padding-top: 2px; padding-bottom: 4px;
            Text { text: root.label; color: #c0d8e0; font-size: 12px; font-weight: 500; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            Text { text: root.display-value; color: #4dd8e8; font-size: 12px; font-weight: 700; vertical-alignment: center; }
        }
    }
    Meter { value: root.amount; }
}

component EnvRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    height: 22px;
    background: #00000000;
    HorizontalLayout {
        Text { text: root.label; color: #7a9aaa; font-size: 11px; vertical-alignment: center; }
        Rectangle { horizontal-stretch: 1; }
        Text { text: root.value; color: #e0f0f5; font-size: 11px; font-weight: 700; vertical-alignment: center; }
    }
}

component ControlBtn inherits Rectangle {
    in property <string> icon;
    in property <bool> active;
    callback clicked();
    width: 48px; height: 48px; border-radius: 24px;
    border-width: 1.5px;
    border-color: root.active ? #3ae0eeaa : #2a4a5a55;
    background: root.active ? #1ab8c818 : #0a1f2d44;
    Text {
        text: root.icon;
        color: root.active ? #5ff0e6 : #5a8a9a;
        font-size: 18px;
        horizontal-alignment: center; vertical-alignment: center;
    }
    TouchArea { clicked => { root.clicked(); } }
}

component VoiceCore inherits Rectangle {
    in property <float> anim-phase;
    in property <bool> active;
    width: 300px; height: 300px;
    background: #00000000;

    // Outermost ring
    Rectangle {
        x: 0px; y: 0px; width: 300px; height: 300px;
        border-radius: 150px; border-width: 1px;
        border-color: #1a4a5a44;
    }
    // Second ring with subtle glow
    Rectangle {
        x: 25px; y: 25px; width: 250px; height: 250px;
        border-radius: 125px; border-width: 1px;
        border-color: #2a6a7a55;
        background: @radial-gradient(circle, #1ab8ca0a 0%, #00000000 65%);
    }
    // Third ring — main glow ring
    Rectangle {
        x: 52px; y: 52px; width: 196px; height: 196px;
        border-radius: 98px; border-width: 1.5px;
        border-color: root.active ? #3ae0ee77 : #3ae0ee28;
        background: @radial-gradient(circle, #1ab8ca12 0%, #00000000 60%);
        opacity: root.active ? (0.7 + 0.25 * Math.sin(root.anim-phase * 180deg)) : 0.35;
        animate opacity { duration: 350ms; }
    }
    // Inner core
    Rectangle {
        x: 84px; y: 84px; width: 132px; height: 132px;
        border-radius: 66px; border-width: 2px;
        border-color: root.active ? #3ae0eebb : #3ae0ee33;
        background: @radial-gradient(circle, #1ab8ca15, #060e18e8);
        animate border-color { duration: 300ms; }
    }

    // Decoration dots on rings
    Rectangle { x: 147px; y: 2px; width: 6px; height: 6px; border-radius: 3px; background: #3ae0ee66; }
    Rectangle { x: 242px; y: 180px; width: 5px; height: 5px; border-radius: 3px; background: #3ae0ee44; }
    Rectangle { x: 54px; y: 232px; width: 5px; height: 5px; border-radius: 3px; background: #3ae0ee33; }

    // Waveform bars (9 bars, symmetric bell curve)
    HorizontalLayout {
        x: 110px; y: 130px; width: 80px; height: 40px;
        spacing: 4px; alignment: center;
        Rectangle { width: 3px; border-radius: 2px; background: #5ff0e6;
            height: root.active ? (6px + 8px * Math.sin(root.anim-phase * 180deg + 0deg)) : 4px;
            y: (40px - self.height) / 2; animate height { duration: 100ms; easing: ease-in-out; } }
        Rectangle { width: 3px; border-radius: 2px; background: #5ff0e6;
            height: root.active ? (10px + 10px * Math.sin(root.anim-phase * 180deg + 35deg)) : 4px;
            y: (40px - self.height) / 2; animate height { duration: 100ms; easing: ease-in-out; } }
        Rectangle { width: 3px; border-radius: 2px; background: #5ff0e6;
            height: root.active ? (18px + 10px * Math.sin(root.anim-phase * 180deg + 70deg)) : 5px;
            y: (40px - self.height) / 2; animate height { duration: 100ms; easing: ease-in-out; } }
        Rectangle { width: 3px; border-radius: 2px; background: #5ff0e6;
            height: root.active ? (26px + 8px * Math.sin(root.anim-phase * 180deg + 105deg)) : 6px;
            y: (40px - self.height) / 2; animate height { duration: 100ms; easing: ease-in-out; } }
        // Center bar
        Rectangle { width: 4px; border-radius: 2px; background: #5ff0e6;
            height: root.active ? (30px + 6px * Math.sin(root.anim-phase * 180deg + 140deg)) : 7px;
            y: (40px - self.height) / 2; animate height { duration: 100ms; easing: ease-in-out; } }
        Rectangle { width: 3px; border-radius: 2px; background: #5ff0e6;
            height: root.active ? (26px + 8px * Math.sin(root.anim-phase * 180deg + 175deg)) : 6px;
            y: (40px - self.height) / 2; animate height { duration: 100ms; easing: ease-in-out; } }
        Rectangle { width: 3px; border-radius: 2px; background: #5ff0e6;
            height: root.active ? (18px + 10px * Math.sin(root.anim-phase * 180deg + 210deg)) : 5px;
            y: (40px - self.height) / 2; animate height { duration: 100ms; easing: ease-in-out; } }
        Rectangle { width: 3px; border-radius: 2px; background: #5ff0e6;
            height: root.active ? (10px + 10px * Math.sin(root.anim-phase * 180deg + 245deg)) : 4px;
            y: (40px - self.height) / 2; animate height { duration: 100ms; easing: ease-in-out; } }
        Rectangle { width: 3px; border-radius: 2px; background: #5ff0e6;
            height: root.active ? (6px + 8px * Math.sin(root.anim-phase * 180deg + 280deg)) : 4px;
            y: (40px - self.height) / 2; animate height { duration: 100ms; easing: ease-in-out; } }
    }
}


// ═══════════════════════════════════════════════════════════════════════════
//  MAIN WINDOW
// ═══════════════════════════════════════════════════════════════════════════

export component AurixCommandCenter inherits Window {
    title: "A.U.R.I.X Command Center";
    preferred-width: 1400px;
    preferred-height: 800px;
    min-width: 950px;
    min-height: 620px;
    background: #080f1a;

    // ── Properties bound from Rust ──
    in-out property <string> live-date: "SUN, AUG 23, 2026";
    in-out property <string> live-time: "03:34:07";
    in-out property <string> system-temp: "38.4°C";

    in-out property <float> cpu-usage: 0.34;
    in-out property <string> cpu-display: "34%";
    in-out property <string> ram-display: "9.2 / 16 GB";
    in-out property <float> ram-usage: 0.57;
    in-out property <string> disk-display: "41%";
    in-out property <float> disk-usage: 0.41;

    in-out property <string> ram-vram-display: "16 / 12";
    in-out property <string> budget-display: "GB";
    in-out property <string> offline-mode: "ENABLED";
    in-out property <string> resource-gov: "NOMINAL";

    in-out property <string> uptime-display: "00:00:00";
    in-out property <string> sessions-count: "03";
    in-out property <string> commands-count: "248";
    in-out property <float> system-load: 0.28;
    in-out property <string> system-load-display: "28%";

    in-out property <float> anim-phase: 0.0;
    in-out property <bool> camera-active: false;
    in-out property <bool> microphone-active: true;
    in-out property <bool> keyboard-active: false;

    in-out property <string> message-text: "";
    in-out property <string> toast-message: "";
    in-out property <bool> toast-visible: false;
    in-out property <[ChatMessage]> messages: [
        { sender: "AURIX", text: "A.U.R.I.X online. All local systems are stable and ready for your command.", time: "" }
    ];

    callback send-message(string);
    callback clear-conversation();
    callback export-conversation();

    // ── Full Window Background Grid ──
    Rectangle {
        width: 100%; height: 100%; background: #080f1a; clip: true;
        Rectangle { width: 100%; height: 100%; background: @radial-gradient(circle, #0f3a4a12 0%, #00000000 55%); }
        for row in 35: Rectangle { y: row * 40px; width: 100%; height: 1px; background: #1a3a4a10; }
        for col in 60: Rectangle { x: col * 40px; width: 1px; height: 100%; background: #1a3a4a10; }
    }

    VerticalLayout {
        width: 100%; height: 100%; spacing: 0px;

        // ═══════════════ HEADER BAR ═══════════════
        Rectangle {
            height: 64px;
            background: #0a1520dd;
            border-width: 1px;
            border-color: #1d3a4a44;

            HorizontalLayout {
                width: 100%; height: 100%;
                padding-left: 24px; padding-right: 24px;

                // LEFT: Logo + Title + Online badge
                HorizontalLayout {
                    spacing: 14px; alignment: start;

                    // Logo icon
                    Rectangle {
                        width: 36px; height: 36px; border-radius: 10px;
                        border-width: 1px; border-color: #3ae0ee44; background: #1ab8c80e;
                        y: (parent.height - self.height) / 2;
                        Text { text: "◎"; color: #5ff0e6; font-size: 18px;
                            horizontal-alignment: center; vertical-alignment: center; }
                    }

                    // Title
                    VerticalLayout {
                        spacing: 1px; alignment: center;
                        Text { text: "A.U.R.I.X"; color: #e0f0f5; font-size: 16px; font-weight: 700; letter-spacing: 3px; }
                        Text { text: "INTELLIGENCE CORE"; color: #5a7a8a; font-size: 8px; letter-spacing: 1.5px; font-weight: 600; }
                    }

                    Rectangle { width: 14px; }

                    // Online badge
                    Rectangle {
                        width: 90px; height: 26px; border-radius: 13px;
                        border-width: 1px; border-color: #68f0a933; background: #68f0a90a;
                        y: (parent.height - self.height) / 2;
                        HorizontalLayout {
                            padding-left: 10px; spacing: 7px; alignment: center;
                            Rectangle { width: 7px; height: 7px; border-radius: 4px; background: #68f0a9;
                                y: (parent.height - self.height) / 2; }
                            Text { text: "Online"; color: #d0f0d8; font-size: 10px; font-weight: 600; vertical-alignment: center; }
                        }
                    }
                }

                // Center Spacer
                Rectangle { horizontal-stretch: 1; }

                // CENTER: Date + Time
                VerticalLayout {
                    spacing: 2px; alignment: center;
                    Text { text: root.live-date; color: #5a7a8a; font-size: 10px; horizontal-alignment: center; letter-spacing: 1px; }
                    Text { text: root.live-time; color: #e0f0f5; font-size: 18px; horizontal-alignment: center; font-weight: 600; }
                }

                // Right Spacer
                Rectangle { horizontal-stretch: 1; }

                // RIGHT: System Temp box
                Rectangle {
                    width: 130px; height: 44px; border-radius: 10px;
                    border-width: 1px; border-color: #1d3a4a66; background: #0c1a2688;
                    y: (parent.height - self.height) / 2;
                    VerticalLayout {
                        padding: 6px; alignment: center; spacing: 1px;
                        Text { text: "SYSTEM TEMP"; color: #5a7a8a; font-size: 8px; horizontal-alignment: center; letter-spacing: 1px; font-weight: 600; }
                        Text { text: root.system-temp; color: #5ff0e6; font-size: 15px; horizontal-alignment: center; font-weight: 700; }
                    }
                }
            }
        }

        // ═══════════════ MAIN 3-COLUMN BODY (CENTERED COMPACT DASHBOARD) ═══════════════
        HorizontalLayout {
            vertical-stretch: 1;
            alignment: center;
            padding-top: 18px;
            padding-bottom: 18px;
            spacing: 18px;

            // ───── LEFT COLUMN: Telemetry (260px fixed width) ─────
            VerticalLayout {
                width: 260px;
                horizontal-stretch: 0;
                spacing: 14px;

                // SYSTEM STATS
                SidePanel {
                    height: 200px;
                    VerticalLayout {
                        padding: 16px; spacing: 8px;
                        HorizontalLayout {
                            height: 22px;
                            Text { text: "System Stats"; color: #e0f0f5; font-size: 14px; font-weight: 700; }
                            Rectangle { horizontal-stretch: 1; }
                            Text { text: "⌁"; color: #4dd8e8; font-size: 16px; }
                        }
                        StatRow { label: "CPU"; display-value: root.cpu-display; amount: root.cpu-usage; }
                        StatRow { label: "RAM"; display-value: root.ram-display; amount: root.ram-usage; }
                        StatRow { label: "DISK"; display-value: root.disk-display; amount: root.disk-usage; }
                    }
                }

                // WORKSPACE ENVIRONMENT
                SidePanel {
                    height: 165px;
                    VerticalLayout {
                        padding: 16px; spacing: 7px;
                        HorizontalLayout {
                            height: 36px;
                            VerticalLayout {
                                spacing: 0px;
                                Text { text: "Workspace"; color: #e0f0f5; font-size: 14px; font-weight: 700; }
                                Text { text: "Environment"; color: #e0f0f5; font-size: 14px; font-weight: 700; }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            Text { text: "⊕"; color: #4dd8e8; font-size: 16px; }
                        }
                        EnvRow { label: "RAM / VRAM"; value: root.ram-vram-display; }
                        EnvRow { label: "BUDGET"; value: root.budget-display; }
                        EnvRow { label: "OFFLINE MODE"; value: root.offline-mode; }
                        EnvRow { label: "RESOURCE GOV."; value: root.resource-gov; }
                    }
                }

                // SYSTEM UPTIME
                SidePanel {
                    height: 145px;
                    VerticalLayout {
                        padding: 16px; spacing: 8px;
                        HorizontalLayout {
                            height: 22px;
                            Text { text: "System Uptime"; color: #e0f0f5; font-size: 14px; font-weight: 700; }
                            Rectangle { horizontal-stretch: 1; }
                            Text { text: "⏱"; color: #4dd8e8; font-size: 16px; }
                        }
                        HorizontalLayout {
                            height: 38px; spacing: 4px;
                            VerticalLayout {
                                horizontal-stretch: 1; spacing: 3px;
                                Text { text: "UPTIME"; color: #5a7a8a; font-size: 8px; letter-spacing: 0.5px; font-weight: 600; }
                                Text { text: root.uptime-display; color: #e0f0f5; font-size: 12px; font-weight: 700; }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1; spacing: 3px;
                                Text { text: "SESSIONS"; color: #5a7a8a; font-size: 8px; letter-spacing: 0.5px; font-weight: 600; }
                                Text { text: root.sessions-count; color: #e0f0f5; font-size: 12px; font-weight: 700; }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1; spacing: 3px;
                                Text { text: "COMMANDS"; color: #5a7a8a; font-size: 8px; letter-spacing: 0.5px; font-weight: 600; }
                                Text { text: root.commands-count; color: #e0f0f5; font-size: 12px; font-weight: 700; }
                            }
                        }
                        VerticalLayout {
                            spacing: 4px;
                            HorizontalLayout {
                                height: 14px;
                                Text { text: "SYSTEM LOAD"; color: #5a7a8a; font-size: 9px; letter-spacing: 0.5px; font-weight: 600; }
                                Rectangle { horizontal-stretch: 1; }
                                Text { text: root.system-load-display; color: #4dd8e8; font-size: 9px; font-weight: 700; }
                            }
                            Meter { value: root.system-load; }
                        }
                    }
                }

                Rectangle { vertical-stretch: 1; background: #00000000; }
            }

            // ───── CENTER COLUMN: Voice Workspace Panel (compact 440px fixed width) ─────
            Rectangle {
                width: 440px;
                horizontal-stretch: 0;
                vertical-stretch: 1;
                border-radius: 16px;
                border-width: 1px;
                border-color: #1d3a4a55;
                background: #0a1724cc;
                clip: true;

                VerticalLayout {
                    width: 100%; height: 100%;
                    padding: 16px; spacing: 8px;

                    // Header row inside center panel
                    HorizontalLayout {
                        height: 24px;
                        Text { text: "• VOICE INTERFACE // LOCAL"; color: #4dd8e8; font-size: 10px; letter-spacing: 1.2px; font-weight: 600; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                        VerticalLayout {
                            alignment: center; spacing: 1px;
                            Text { text: "CORE ID"; color: #5a7a8a; font-size: 8px; horizontal-alignment: right; letter-spacing: 0.8px; }
                            Text { text: "AUR-IX.04"; color: #4dd8e8; font-size: 11px; horizontal-alignment: right; font-weight: 700; }
                        }
                    }

                    // Main centered area
                    VerticalLayout {
                        vertical-stretch: 1;
                        alignment: center; spacing: 10px;

                        VoiceCore {
                            anim-phase: root.anim-phase;
                            active: root.microphone-active;
                            horizontal-stretch: 0;
                        }

                        Text {
                            text: "A.U.R.I.X"; color: #e0f0f5; font-size: 18px; font-weight: 700;
                            letter-spacing: 5px; horizontal-alignment: center;
                        }

                        // Listening status pill
                        Rectangle {
                            width: 220px; height: 28px; border-radius: 14px;
                            background: root.microphone-active ? #1ab8c80c : #ff44440c;
                            border-width: 1px;
                            border-color: root.microphone-active ? #3ae0ee44 : #ff444444;
                            HorizontalLayout {
                                padding-left: 14px; spacing: 6px; alignment: center;
                                Text { text: "*"; color: root.microphone-active ? #68f0a9 : #ff6666; font-size: 13px; vertical-alignment: center; font-weight: 700; }
                                Text {
                                    text: root.microphone-active ? "Listening for wake word.." : "Microphone muted";
                                    color: root.microphone-active ? #7abac5 : #aa6666;
                                    font-size: 11px; vertical-alignment: center;
                                }
                            }
                        }

                        Rectangle { height: 12px; background: #00000000; }

                        // Control buttons
                        HorizontalLayout {
                            spacing: 16px; alignment: center;
                            ControlBtn { icon: "◉"; active: root.camera-active; clicked => { root.camera-active = !root.camera-active; } }
                            ControlBtn { icon: "♩"; active: root.microphone-active; clicked => { root.microphone-active = !root.microphone-active; } }
                            ControlBtn { icon: "⌨"; active: root.keyboard-active; clicked => { root.keyboard-active = !root.keyboard-active; } }
                        }
                    }
                }
            }

            // ───── RIGHT COLUMN: Conversation Panel (compact 360px fixed width) ─────
            Rectangle {
                width: 360px;
                horizontal-stretch: 0;
                vertical-stretch: 1;
                border-radius: 16px;
                border-width: 1px;
                border-color: #1d3a4a55;
                background: #0a1724cc;
                clip: true;

                VerticalLayout {
                    width: 100%; height: 100%;
                    padding: 16px; spacing: 10px;

                    // Header
                    HorizontalLayout {
                        height: 22px;
                        Text { text: "Conversation"; color: #e0f0f5; font-size: 15px; font-weight: 700; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                        Text { text: "⇗"; color: #5a7a8a; font-size: 15px; vertical-alignment: center; }
                    }
                    Text { text: "LOCAL CHANNEL // ENCRYPTED"; color: #5a7a8a; font-size: 9px; letter-spacing: 1px; font-weight: 600; }

                    // Clear + Export buttons
                    HorizontalLayout {
                        height: 38px; spacing: 10px;
                        Rectangle {
                            horizontal-stretch: 1; height: 36px; border-radius: 8px;
                            border-width: 1px; border-color: #2a4a5a66; background: #0c1a2688;
                            Text { text: "Clear"; color: #a0bcc5; font-size: 11px; font-weight: 600;
                                horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { clicked => { root.clear-conversation(); } }
                        }
                        Rectangle {
                            horizontal-stretch: 1; height: 36px; border-radius: 8px;
                            border-width: 1px; border-color: #2a4a5a66; background: #0c1a2688;
                            VerticalLayout {
                                alignment: center;
                                Text { text: "Export"; color: #a0bcc5; font-size: 11px; font-weight: 600; horizontal-alignment: center; }
                                Text { text: "Conversation"; color: #a0bcc5; font-size: 11px; font-weight: 600; horizontal-alignment: center; }
                            }
                            TouchArea { clicked => { root.export-conversation(); } }
                        }
                    }

                    // Chat messages thread
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            padding: 2px; spacing: 10px;
                            for msg in root.messages: HorizontalLayout {
                                spacing: 8px; alignment: start;

                                // Avatar icon
                                Rectangle {
                                    visible: msg.sender == "AURIX";
                                    width: 26px; height: 26px; border-radius: 7px;
                                    border-width: 1px; border-color: #2a4a5a55; background: #0c1e2caa;
                                    vertical-stretch: 0;
                                    Text { text: "⬡"; color: #4dd8e8; font-size: 12px;
                                        horizontal-alignment: center; vertical-alignment: center; }
                                }

                                // Message bubble
                                Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: 10px;
                                    background: msg.sender == "USER" ? #1ab8c812 : #0c1e2caa;
                                    border-width: 1px;
                                    border-color: msg.sender == "USER" ? #3ae0ee33 : #1d3a4a55;

                                    Rectangle {
                                        x: 0px; y: 6px; width: 3px;
                                        height: parent.height - 12px;
                                        border-radius: 2px;
                                        background: msg.sender == "USER" ? #4dd8e8 : #3ae0ee44;
                                    }

                                    VerticalLayout {
                                        padding-left: 12px; padding-right: 12px;
                                        padding-top: 10px; padding-bottom: 10px;
                                        spacing: 3px;
                                        Text { text: msg.text; color: #c0d8e0; font-size: 12px; wrap: word-wrap; }
                                    }
                                }
                            }
                        }
                    }

                    // Message input box
                    Rectangle {
                        height: 44px; border-radius: 10px;
                        border-width: 1px; border-color: #1d3a4a66; background: #0c1a26cc;

                        HorizontalLayout {
                            padding-left: 6px; padding-right: 6px;
                            padding-top: 4px; padding-bottom: 4px;
                            spacing: 8px;
                            Rectangle {
                                horizontal-stretch: 1;
                                LineEdit {
                                    width: 100%; height: 100%;
                                    text <=> root.message-text;
                                    placeholder-text: "Send a local command...";
                                    font-size: 12px;
                                    accepted => {
                                        if (root.message-text != "") {
                                            root.send-message(root.message-text);
                                            root.message-text = "";
                                        }
                                    }
                                }
                            }
                            Rectangle {
                                width: 36px; height: 36px; border-radius: 8px;
                                background: #1894a8;
                                y: (parent.height - self.height) / 2;
                                Text { text: "➤"; color: #ffffff; font-size: 14px;
                                    horizontal-alignment: center; vertical-alignment: center; }
                                TouchArea {
                                    clicked => {
                                        if (root.message-text != "") {
                                            root.send-message(root.message-text);
                                            root.message-text = "";
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // Toast notification
    Rectangle {
        visible: root.toast-visible;
        x: (parent.width - self.width) / 2; y: 76px;
        width: 320px; height: 36px;
        border-radius: 18px; border-width: 1px; border-color: #4dd8e877;
        background: #0c1a26f0; z: 20;
        HorizontalLayout {
            padding-left: 14px; padding-right: 14px; spacing: 8px; alignment: center;
            Text { text: "ℹ"; color: #4dd8e8; font-size: 12px; vertical-alignment: center; }
            Text { text: root.toast-message; color: #e0f0f5; font-size: 11px; vertical-alignment: center; font-weight: 600; }
        }
    }
}
